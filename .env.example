# Copy as .env.local (local) or set these in Vercel. Never commit .env.local.

# Public URL of the site (Open Graph, sitemap). PENDING: the domain.
NEXT_PUBLIC_SITE_URL=https://galos.example

# GoHighLevel inbound webhook for forms (server only). PENDING.
GHL_WEBHOOK_URL=

# GoHighLevel calendar link for "Book a call". PENDING.
NEXT_PUBLIC_BOOKING_URL=

# "false" hides every PENDING tag (only when everything is confirmed).
NEXT_PUBLIC_SHOW_PENDING=true
